# Application
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# Sign-in (single user). Run `npm run hash-password -w @studio/api` and paste both lines here.
# Empty leaves the app open, but approving and submitting applications then refuse to run.
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Other origins allowed to send state-changing requests (the web app's own proxy needs none).
APP_ORIGINS=

# Postgres (local / Compose)
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# Local media
STORAGE_DIR=./storage
MAX_PHOTO_BYTES=8388608

# Text generation provider: openai or anthropic (used from Slice 2)
TEXT_PROVIDER=openai

# OpenAI (used when TEXT_PROVIDER=openai and/or IMAGE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic / Claude (used when TEXT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5

# Image generation provider: openai (needs OPENAI_API_KEY + credits, supports
# reference-photo identity preservation) or pollinations (free, no key, no
# reference-photo support) (used from Slice 6)
IMAGE_PROVIDER=openai

# News (used from Slice 3)
NEWS_API_KEY=
NEWS_LOOKBACK_DAYS=21

# Adzuna job search (Career module) — free, instant key at developer.adzuna.com.
# Greenhouse/Lever/Ashby (board import) and RemoteOK/Arbeitnow/Remotive/Himalayas (job search) need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Background worker (BullMQ on Redis) — see ADR-015. Compose runs Redis and the worker for you;
# for a host-run worker (`npm run worker -w @studio/api`) point this at a local Redis.
REDIS_URL=redis://localhost:6379
WORKER_HEARTBEAT_MS=300000
# Browser worker (application preparation). Empty uses Playwright's own Chromium.
BROWSER_EXECUTABLE_PATH=
BROWSER_RUN_TIMEOUT_MS=120000
# Let the browser worker submit approved applications on portals set to AUTOMATED in source
# settings (PATCH /api/career/sources/:id). Off: approving leads to submitting by hand.
APPLICATION_SUBMISSION_ENABLED=false
# Development only: serve mock Greenhouse, Lever and Ashby pages instead of the network.
BROWSER_MOCK_PORTALS=false

# Scheduled job discovery (Job Hunter). The worker searches each source once a day with each
# keyword; "Run discovery now" (POST /api/career/discovery/run) queues today's run early.
# Adzuna joins only if listed here and its keys are set. Remotive allows 2 requests/minute,
# so keep its keyword list short.
DISCOVERY_SOURCES=remotive,himalayas,remoteok,arbeitnow,weworkremotely
DISCOVERY_KEYWORDS=typescript,node.js,angular,tech lead,forward deployed engineer,ai engineer
DISCOVERY_CRON=0 9 * * *
# Web search discovery through the Brave Search API (paid, US$5 per 1,000 searches with a
# monthly credit). Off when empty. Six searches a day, one per ATS domain, for these titles.
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TITLES=senior software engineer,senior fullstack engineer,tech lead,forward deployed engineer,ai engineer
DISCOVERY_TZ=America/Sao_Paulo
# Matching v2 compensation target in USD per month.
MATCH_TARGET_USD_MONTHLY=6000
# Comma-separated words or phrases a wanted job title contains (synonyms included). Empty keeps
# the defaults: seniority words plus Forward Deployed / AI Engineer and their variants.
MATCH_TARGET_ROLES=
# Explanation agent: jobs scoring at least this are explained by the text provider above,
# at most EXPLANATION_DAILY_LIMIT per day (UTC). Without an API key, jobs are scored only.
EXPLANATION_MIN_SCORE=60
EXPLANATION_DAILY_LIMIT=25
